{
  "name": "portfolio-qa-daniel",
  "version": "1.0.0",
  "description": "QA portfolio with automated tests and e2e documentation",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:critical": "playwright test --grep @critical",
    "test:smoke": "playwright test --grep @smoke",
    "test:negative": "playwright test --grep @negative",
    "test:hp": "playwright test --grep @happy-path",
    "test:tag": "playwright test --grep",
    "generate:testplan": "node scripts/generate-testplan.js",
    "generate:testcase": "node scripts/generate-testcase.js",
    "generate:testreport": "node scripts/generate-testreport.js",
    "generate:testresult": "node scripts/generate-testresult.js",
    "install:browsers": "playwright install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danielrbrito07/portfolio-qa-daniel.git"
  },
  "keywords": [
    "qa",
    "quality-assurance",
    "test-automation",
    "e2e-testing",
    "playwright",
    "playwright-testing",
    "typescript",
    "end-to-end-tests",
    "automation-testing",
    "testing-framework",
    "qa-portfolio",
    "software-testing",
    "test-engineering",
    "ci-cd",
    "github-actions"
  ],
  "author": "Daniel Brito",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Danielrbrito07/portfolio-qa-daniel/issues"
  },
  "homepage": "https://github.com/Danielrbrito07/portfolio-qa-daniel#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
